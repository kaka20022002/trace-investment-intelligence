# 复制为项目根目录 .env；读取 .env 需要 Node.js 20.12+，推荐 Node.js 22。
# 所有模型配置只用于服务器。不要使用 VITE_ 前缀，也不要提交真实密钥。
# 留空时不调用模型：/api/health 返回 rules，/api/analyze 返回 503，前端可选择本地规则。
OPENAI_API_KEY=

# OpenAI-compatible API 根地址，包含 /v1（如供应商要求），不包含 /chat/completions。
# 必须支持 chat completions 与 response_format: { type: "json_object" }。
# 生产环境请使用 HTTPS；仅本地可信模型服务建议使用 HTTP。
# 这里是固定服务端配置，分析接口不接受或抓取用户 URL；不跟随远端重定向。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

PORT=4173
# 默认仅本机可访问；需要对外提供服务时，显式设置 HOST=0.0.0.0。
# 此版本无用户登录。公开服务前应由网关补充访问控制和全局限流。
HOST=127.0.0.1

# 原文 10–20000 字符，参考事件最多 100 条，请求体上限 256 KiB。
# 模型调用总超时 20 秒；单进程每个直连 IP 每分钟最多 15 次分析。
# 不信任 X-Forwarded-For；反向代理下请求可能共享同一额度。
# 引用必须逐字存在于原文；模型结构错误、虚构引用与远程错误均不会伪装为 AI 成功。
# 模型模式会将原文和所提交事件参考发送给上面的供应商，请勿提交敏感信息。
